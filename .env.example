# outcry — every value here is a default you can read in src/config.ts.
# Nothing in this file is required for `doctor`, `tape`, `book`, `replay`,
# `receipts`, `positions` or any paper session on the synthetic feed.

# ─── models ──────────────────────────────────────────────────────────────────
# Seats are bound to models by role, not by name. Any OpenAI-compatible
# endpoint works; see docs/SEATS.md for what each seat is asked to do.
# With no key set, every seat falls back to its deterministic stub and the
# floor still runs end to end — that is how the test suite runs offline.

XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Which model sits in which chair. Fast on the tape, strong on the gate,
# cheap overnight. Change any of these without touching code.
MODEL_TAPE=grok-4.1-fast
MODEL_DESK=claude-sonnet-4-5
MODEL_GATE=claude-opus-4-5
MODEL_FLOOR=grok-4.1
MODEL_OVERNIGHT=claude-haiku-4-5

# ─── the floor ───────────────────────────────────────────────────────────────
FLOOR_MODE=paper              # paper | replay  (there is no live mode; see docs/SAFETY.md)
FLOOR_EQUITY=250000
FLOOR_UNIVERSE=NVDA,TSM,MU,AVGO,META
FLOOR_TICK_MS=1000            # how often the tape publishes a snapshot
FLOOR_SESSION_MIN=390         # a full US session, in market minutes

# ─── risk gate ───────────────────────────────────────────────────────────────
# Hard limits are enforced in code before any model is asked for an opinion.
# A model can only ever make the gate stricter, never looser. docs/RISK.md.
RISK_MAX_TICKET_PCT=4         # one ticket, as % of equity
RISK_MAX_POSITION_PCT=12      # one name, as % of equity
RISK_MAX_GROSS_PCT=90         # sum of all positions, as % of equity
RISK_MAX_NET_PCT=60           # long minus short, as % of equity
RISK_MAX_NAMES=8              # open names at once
RISK_DAY_STOP_PCT=3           # session loss that closes the floor for the day
RISK_QUEUE_DEPTH=6            # tickets allowed to wait at the gate

# ─── execution ───────────────────────────────────────────────────────────────
EXEC_STYLE=work               # work | sweep   (`work` walks the book level by level)
EXEC_MAX_LEVELS=5             # how deep one child order may reach
EXEC_PARTICIPATION=8          # % of displayed size a child order may take
EXEC_MIN_CHILD=1              # smallest child order, in shares
EXEC_REPLENISH=60             # % of a lifted level that comes back before the next child
                              # order. This one assumption is the entire advantage `work`
                              # claims over `sweep`. Set it to 0 to price every order
                              # against a book that never comes back. docs/EXECUTION.md.

# ─── tape ────────────────────────────────────────────────────────────────────
TAPE_SOURCE=synthetic         # synthetic | csv
TAPE_CSV_DIR=./data/bars      # one <SYMBOL>.csv per name: ts,open,high,low,close,volume
TAPE_SEED=1792                # synthetic feed is seeded, so a session is reproducible

# ─── floorview ───────────────────────────────────────────────────────────────
VIEW_PORT=1792                # binds 127.0.0.1 only
VIEW_OPEN=false               # open a browser on start

# ─── ledger ──────────────────────────────────────────────────────────────────
DATA_DIR=./data               # receipts, positions and session summaries land here
